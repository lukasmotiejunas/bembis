# Nukopijuokite į .env.local (kompiuteryje) ir įrašykite tas pačias reikšmes Vercel → Settings → Environment Variables.

# Stripe slaptasis raktas: https://dashboard.stripe.com/test/apikeys
# sk_test_... = testiniai (netikri) mokėjimai, sk_live_... = tikri mokėjimai
STRIPE_SECRET_KEY=sk_test_...

# Vietoje: test. Vercel Production: live su tos pačios paskyros sk_live/rk_live raktu ir live webhook.
STRIPE_PAYMENT_MODE=test

# Laikinas 1 € produktas. Po realaus bandymo pakeiskite į false ir perkurkite diegimą.
PAYMENT_TEST_ENABLED=false

# Stripe webhook parašo raktas (Stripe → Developers → Webhooks → jūsų endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Apps Script web app adresas ir slaptažodis (žr. integrations/google-sheets/README.md)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
GOOGLE_SHEETS_SECRET=tas-pats-kaip-ORDERS_WEBHOOK_SECRET-Script-Property

# Kam siunčiami užklausų ir apmokėtų užsakymų pranešimai (atskirkite kableliais).
# Apps Script NOTIFICATION_EMAILS savybė, jei nustatyta, turi pirmenybę.
INQUIRY_EMAILS=info@kaledudekoras.lt,jusu-asmeninis@gmail.com

# Google Analytics 4: viešas Web duomenų srauto matavimo ID. Po pakeitimo perkurkite diegimą.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
